{
  "name": "@learn-by-diff/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Git feature-increment learning environments for VS Code and Cursor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RJiazhen/learn-by-diff.git"
  },
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r pack",
    "check": "vp check",
    "test": "vp run -r test",
    "pack": "vp run -r pack",
    "reset:sandbox": "node scripts/reset-sandbox.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
