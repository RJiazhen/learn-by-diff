{
  "name": "learn-by-diff",
  "displayName": "LearnByDiff",
  "version": "0.1.0",
  "private": true,
  "description": "Turn GitHub source and increment tutorials into a real local learning workspace.",
  "categories": [
    "Education",
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RJiazhen/learn-by-diff.git"
  },
  "publisher": "rjiazhen",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "pack": "vp pack",
    "watch": "vp pack --watch",
    "vscode:prepublish": "vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@learn-by-diff/protocol": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "learnByDiff.openCourse",
        "title": "LearnByDiff: Open Course"
      },
      {
        "command": "learnByDiff.nextChapter",
        "title": "LearnByDiff: Next Chapter",
        "icon": "$(arrow-right)"
      },
      {
        "command": "learnByDiff.previousChapter",
        "title": "LearnByDiff: Previous Chapter",
        "icon": "$(arrow-left)"
      },
      {
        "command": "learnByDiff.openDiff",
        "title": "LearnByDiff: Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "learnByDiff.runTests",
        "title": "LearnByDiff: Run Tests",
        "icon": "$(testing-run-all-icon)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "learnByDiff.courseView",
          "name": "LearnByDiff",
          "when": "learnByDiff.isLearningWorkspace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "learnByDiff.previousChapter",
          "when": "view == learnByDiff.courseView",
          "group": "navigation@1"
        },
        {
          "command": "learnByDiff.nextChapter",
          "when": "view == learnByDiff.courseView",
          "group": "navigation@2"
        },
        {
          "command": "learnByDiff.openDiff",
          "when": "view == learnByDiff.courseView",
          "group": "navigation@3"
        },
        {
          "command": "learnByDiff.runTests",
          "when": "view == learnByDiff.courseView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "learnByDiff.openDiff",
          "when": "view == learnByDiff.courseView && viewItem == chapter",
          "group": "inline"
        }
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:.learn/progress.json"
  ],
  "engines": {
    "vscode": "^1.90.0"
  }
}
