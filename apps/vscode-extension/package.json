{
  "name": "learn-by-diff",
  "displayName": "LearnByDiff",
  "version": "0.5.0",
  "private": true,
  "description": "%learnByDiff.extension.description%",
  "categories": [
    "Education",
    "Other"
  ],
  "homepage": "https://rjiazhen.github.io/learn-by-diff/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RJiazhen/learn-by-diff.git"
  },
  "publisher": "RuanJiazhen",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "pack": "vp pack",
    "package": "vp run @learn-by-diff/protocol#pack && vsce package --no-dependencies",
    "watch": "vp pack --watch",
    "vscode:prepublish": "node ../../scripts/copy-extension-readme.mjs && vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@learn-by-diff/protocol": "workspace:*",
    "ignore": "catalog:",
    "jsonc-parser": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "learnByDiff.openCourse",
        "title": "%learnByDiff.openCourse.title%",
        "category": "LearnByDiff",
        "icon": "$(folder-opened)"
      },
      {
        "command": "learnByDiff.nextChapter",
        "title": "%learnByDiff.nextChapter.title%",
        "category": "LearnByDiff",
        "icon": "$(arrow-right)"
      },
      {
        "command": "learnByDiff.previousChapter",
        "title": "%learnByDiff.previousChapter.title%",
        "category": "LearnByDiff",
        "icon": "$(arrow-left)"
      },
      {
        "command": "learnByDiff.searchChapter",
        "title": "%learnByDiff.searchChapter.title%",
        "category": "LearnByDiff",
        "icon": "$(search)"
      },
      {
        "command": "learnByDiff.scrollToCurrentChapter",
        "title": "%learnByDiff.scrollToCurrentChapter.title%",
        "icon": "$(target)"
      },
      {
        "command": "learnByDiff.copyCurrentCourseUrl",
        "title": "%learnByDiff.copyCurrentCourseUrl.title%",
        "category": "LearnByDiff",
        "icon": "$(copy)"
      },
      {
        "command": "learnByDiff.copyWorkspaceCourseUrl",
        "title": "%learnByDiff.copyWorkspaceCourseUrl.title%",
        "category": "LearnByDiff"
      },
      {
        "command": "learnByDiff.copyOneClickOpenUrl",
        "title": "%learnByDiff.copyOneClickOpenUrl.title%",
        "category": "LearnByDiff",
        "icon": "$(link-external)"
      },
      {
        "command": "learnByDiff.openFileDiff",
        "title": "%learnByDiff.openFileDiff.title%",
        "category": "LearnByDiff"
      },
      {
        "command": "learnByDiff.installGenerateCourseSkill",
        "title": "%learnByDiff.installGenerateCourseSkill.title%",
        "category": "LearnByDiff",
        "icon": "$(tools)"
      },
      {
        "command": "learnByDiff.applyChapterStart",
        "title": "%learnByDiff.applyChapterStart.title%",
        "icon": "$(circle-large)",
        "enablement": "!(viewItem =~ /^chapter-start(-docs)?$/) || learnByDiff.studentHasEdits"
      },
      {
        "command": "learnByDiff.applyChapterFinish",
        "title": "%learnByDiff.applyChapterFinish.title%",
        "icon": "$(pass)",
        "enablement": "!(viewItem =~ /^chapter-finish(-docs)?$/) || learnByDiff.studentHasEdits"
      },
      {
        "command": "learnByDiff.openChapterDocs",
        "title": "%learnByDiff.openChapterDocs.title%",
        "icon": "$(book)"
      },
      {
        "command": "learnByDiff.openChapterStartFolder",
        "title": "%learnByDiff.openChapterStartFolder.title%",
        "icon": "$(folder)"
      },
      {
        "command": "learnByDiff.openChapterFinishFolder",
        "title": "%learnByDiff.openChapterFinishFolder.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "learnByDiff.viewAsTree",
        "title": "%learnByDiff.viewAsTree.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "learnByDiff.viewAsList",
        "title": "%learnByDiff.viewAsList.title%",
        "icon": "$(list-flat)"
      }
    ],
    "colors": [
      {
        "id": "learnByDiff.currentChapter",
        "description": "%learnByDiff.currentChapter.colorDescription%",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0078D4",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "learnByDiff.courseView",
          "name": "%learnByDiff.courseView.name%",
          "icon": "icon.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "learnByDiff.courseView",
        "contents": "%learnByDiff.viewsWelcome.loading%",
        "when": "!learnByDiff.ready"
      },
      {
        "view": "learnByDiff.courseView",
        "contents": "%learnByDiff.viewsWelcome.downloadingChapterConfig%",
        "when": "learnByDiff.ready && learnByDiff.downloadingChapterConfig && !learnByDiff.isLearningWorkspace"
      },
      {
        "view": "learnByDiff.courseView",
        "contents": "%learnByDiff.viewsWelcome.openCourse%",
        "when": "learnByDiff.ready && !learnByDiff.isLearningWorkspace && !learnByDiff.downloadingChapterConfig"
      }
    ],
    "submenus": [
      {
        "id": "learnByDiff.chapterMore",
        "label": "%learnByDiff.chapterMore.label%",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "learnByDiff.openCourse",
          "when": "view == learnByDiff.courseView && learnByDiff.ready",
          "group": "more@1"
        },
        {
          "command": "learnByDiff.previousChapter",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "more@2"
        },
        {
          "command": "learnByDiff.nextChapter",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "more@3"
        },
        {
          "command": "learnByDiff.scrollToCurrentChapter",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "learnByDiff.searchChapter",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "learnByDiff.copyCurrentCourseUrl",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "more@4"
        },
        {
          "command": "learnByDiff.copyOneClickOpenUrl",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "more@5"
        },
        {
          "command": "learnByDiff.viewAsTree",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace && learnByDiff.viewMode == 'list'",
          "group": "navigation@3"
        },
        {
          "command": "learnByDiff.viewAsList",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace && learnByDiff.viewMode != 'list'",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "learnByDiff.openChapterDocs",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?-docs$/",
          "group": "inline@1"
        },
        {
          "command": "learnByDiff.applyChapterStart",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@2"
        },
        {
          "command": "learnByDiff.applyChapterFinish",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@3"
        },
        {
          "submenu": "learnByDiff.chapterMore",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@4"
        },
        {
          "command": "learnByDiff.applyChapterStart",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@1"
        },
        {
          "command": "learnByDiff.applyChapterFinish",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@2"
        },
        {
          "command": "learnByDiff.openChapterDocs",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?-docs$/",
          "group": "navigation@3"
        },
        {
          "command": "learnByDiff.openChapterStartFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@4"
        },
        {
          "command": "learnByDiff.openChapterFinishFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@5"
        }
      ],
      "learnByDiff.chapterMore": [
        {
          "command": "learnByDiff.openChapterStartFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@1"
        },
        {
          "command": "learnByDiff.openChapterFinishFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "learnByDiff.installGenerateCourseSkill",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "learnByDiff.copyCurrentCourseUrl",
          "when": "learnByDiff.isLearningWorkspace"
        },
        {
          "command": "learnByDiff.copyOneClickOpenUrl",
          "when": "learnByDiff.isLearningWorkspace"
        },
        {
          "command": "learnByDiff.scrollToCurrentChapter",
          "when": "learnByDiff.isLearningWorkspace"
        },
        {
          "command": "learnByDiff.openFileDiff",
          "when": "false"
        },
        {
          "command": "learnByDiff.applyChapterStart",
          "when": "false"
        },
        {
          "command": "learnByDiff.applyChapterFinish",
          "when": "false"
        },
        {
          "command": "learnByDiff.openChapterDocs",
          "when": "false"
        },
        {
          "command": "learnByDiff.openChapterStartFolder",
          "when": "false"
        },
        {
          "command": "learnByDiff.openChapterFinishFolder",
          "when": "false"
        },
        {
          "command": "learnByDiff.viewAsTree",
          "when": "false"
        },
        {
          "command": "learnByDiff.viewAsList",
          "when": "false"
        }
      ]
    }
  },
  "activationEvents": [
    "onUri",
    "onView:learnByDiff.courseView",
    "workspaceContains:.learn/progress.json"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  }
}
