{
  "name": "learn-by-diff",
  "displayName": "LearnByDiff",
  "version": "0.1.0",
  "private": true,
  "description": "Turn GitHub source and increment tutorials into a real local learning workspace.",
  "categories": [
    "Education",
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RJiazhen/learn-by-diff.git"
  },
  "publisher": "rjiazhen",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "pack": "vp pack",
    "watch": "vp pack --watch",
    "vscode:prepublish": "vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@learn-by-diff/protocol": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "learnByDiff.openCourse",
        "title": "LearnByDiff: Open Course",
        "icon": "$(folder-opened)"
      },
      {
        "command": "learnByDiff.nextChapter",
        "title": "LearnByDiff: Next Chapter",
        "icon": "$(arrow-right)"
      },
      {
        "command": "learnByDiff.previousChapter",
        "title": "LearnByDiff: Previous Chapter",
        "icon": "$(arrow-left)"
      },
      {
        "command": "learnByDiff.openFileDiff",
        "title": "LearnByDiff: Open File Diff"
      },
      {
        "command": "learnByDiff.applyChapterStart",
        "title": "Not Started",
        "icon": "$(circle-outline)"
      },
      {
        "command": "learnByDiff.applyChapterFinish",
        "title": "Completed",
        "icon": "$(check)"
      },
      {
        "command": "learnByDiff.openChapterDocs",
        "title": "Open Chapter Docs",
        "icon": "$(book)"
      },
      {
        "command": "learnByDiff.openChapterStartFolder",
        "title": "Open Not Started Folder",
        "icon": "$(folder)"
      },
      {
        "command": "learnByDiff.openChapterFinishFolder",
        "title": "Open Completed Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "learnByDiff.viewAsTree",
        "title": "View as Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "learnByDiff.viewAsList",
        "title": "View as List",
        "icon": "$(list-flat)"
      }
    ],
    "colors": [
      {
        "id": "learnByDiff.currentChapter",
        "description": "Highlight color for the active chapter in the Learn By Diff view",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0078D4",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "learnByDiff.courseView",
          "name": "Learn By Diff"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "learnByDiff.courseView",
        "contents": "Open a LearnByDiff course to start learning.\n[Open Course](command:learnByDiff.openCourse)",
        "when": "!learnByDiff.isLearningWorkspace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "learnByDiff.openCourse",
          "when": "view == learnByDiff.courseView",
          "group": "navigation@0"
        },
        {
          "command": "learnByDiff.previousChapter",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "learnByDiff.nextChapter",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "learnByDiff.viewAsTree",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace && learnByDiff.viewMode == 'list'",
          "group": "navigation@3"
        },
        {
          "command": "learnByDiff.viewAsList",
          "when": "view == learnByDiff.courseView && learnByDiff.isLearningWorkspace && learnByDiff.viewMode != 'list'",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "learnByDiff.openChapterDocs",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?-docs$/",
          "group": "inline@1"
        },
        {
          "command": "learnByDiff.applyChapterStart",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@2"
        },
        {
          "command": "learnByDiff.applyChapterFinish",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@3"
        },
        {
          "command": "learnByDiff.openChapterStartFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@4"
        },
        {
          "command": "learnByDiff.openChapterFinishFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "inline@5"
        },
        {
          "command": "learnByDiff.applyChapterStart",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@1"
        },
        {
          "command": "learnByDiff.applyChapterFinish",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@2"
        },
        {
          "command": "learnByDiff.openChapterDocs",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?-docs$/",
          "group": "navigation@3"
        },
        {
          "command": "learnByDiff.openChapterStartFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@4"
        },
        {
          "command": "learnByDiff.openChapterFinishFolder",
          "when": "view == learnByDiff.courseView && viewItem =~ /^chapter(-start|-finish)?(-docs)?$/",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "learnByDiff.openFileDiff",
          "when": "false"
        },
        {
          "command": "learnByDiff.applyChapterStart",
          "when": "false"
        },
        {
          "command": "learnByDiff.applyChapterFinish",
          "when": "false"
        },
        {
          "command": "learnByDiff.openChapterDocs",
          "when": "false"
        },
        {
          "command": "learnByDiff.openChapterStartFolder",
          "when": "false"
        },
        {
          "command": "learnByDiff.openChapterFinishFolder",
          "when": "false"
        },
        {
          "command": "learnByDiff.viewAsTree",
          "when": "false"
        },
        {
          "command": "learnByDiff.viewAsList",
          "when": "false"
        }
      ]
    }
  },
  "activationEvents": [
    "onUri",
    "onView:learnByDiff.courseView",
    "workspaceContains:.learn/progress.json"
  ],
  "engines": {
    "vscode": "^1.90.0"
  }
}
